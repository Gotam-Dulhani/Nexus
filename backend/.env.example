# Nexus Backend Environment Variables

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/nexus

# JWT Secret for token signing (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Server Port
PORT=5000

# Frontend URL (for CORS and password reset links)
FRONTEND_URL=http://localhost:5173

# Stripe (sandbox keys for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# SMTP Configuration (optional - uses Ethereal mock if not set)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_pass
